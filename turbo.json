{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "ADMIN_JWT_SECRET", "MASTER_ADMIN_PASSWORD", "MASTER_ADMIN_PASSWORT", "FIXED_TENANT_ID", "NEXT_PUBLIC_ADMIN_URL", "BLOB_READ_WRITE_TOKEN", "VERCEL_BLOB_STORE_ID", "CRM_MASTER_PASSWORD", "CRM_JWT_SECRET", "CRM_RATE_LIMIT_SECRET", "CRM_ALLOWED_ORIGIN", "RENDERER_RATE_LIMIT_SECRET", "RENDERER_ALLOWED_ORIGIN", "PREVIEW_SECRET", "REVALIDATE_SECRET", "RENDERER_URL", "SITE_URL", "CRON_SECRET", "PLATFORM_ADMIN_TENANT_IDS", "VERCEL_TOKEN", "VERCEL_TEAM_ID", "VERCEL_RENDERER_PROJECT", "RENDERER_BASE_DOMAIN", "GITHUB_REPO_ID", "GITHUB_REPO_NUMERIC_ID", "SMTP_HOST", "SMTP_PORT", "SMTP_USER", "SMTP_PASS", "SMTP_FROM", "SMTP_SECURE", "PLATFORM_SMTP_HOST", "PLATFORM_SMTP_PORT", "PLATFORM_SMTP_USER", "PLATFORM_SMTP_PASS", "PLATFORM_SMTP_FROM", "PLATFORM_SMTP_SECURE", "META_APP_ID", "META_APP_SECRET", "META_REDIRECT_URI", "DEMO_IG_FALLBACK_SLUG"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
