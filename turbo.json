{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "ADMIN_JWT_SECRET", "FIXED_TENANT_ID", "NEXT_PUBLIC_ADMIN_URL", "BLOB_READ_WRITE_TOKEN", "CRM_MASTER_PASSWORD", "CRM_JWT_SECRET", "VERCEL_TOKEN", "VERCEL_TEAM_ID", "VERCEL_RENDERER_PROJECT", "RENDERER_BASE_DOMAIN", "GITHUB_REPO_ID", "GITHUB_REPO_NUMERIC_ID"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
