  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Die gemeinsame Terminaktion auf heller Fläche; Farben bleiben an die CMS-Buttonrollen gebunden.",
      "html": "<a class=\"ds-button-primary\" href=\"/kontakt\"><span>Termin vereinbaren</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-button-primary{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);display:inline-flex;min-height:3rem;align-items:center;justify-content:center;gap:.6rem;border:1px solid transparent;border-radius:var(--token-button-radius,.125rem);padding:.7rem 1.2rem;font-size:.9375rem;font-weight:650;line-height:1.25;text-decoration:none;background:var(--token-btn-bg,#103B4A);color:var(--token-btn-text,#FFFFFF);box-shadow:0 8px 24px var(--token-shadow,rgba(15,23,42,.08));transition:transform 220ms ease,box-shadow 220ms ease,filter 220ms ease}.ds-button-primary svg{color:inherit;transition:transform 220ms ease}.ds-button-primary:focus-visible{outline:2px solid var(--token-accent,#195D67);outline-offset:2px;border-radius:4px}.ds-button-primary:active{transform:translateY(0)}@media(hover:hover) and (pointer:fine){.ds-button-primary:hover{transform:translateY(-2px);box-shadow:0 14px 32px var(--token-shadow,rgba(15,23,42,.08));filter:brightness(1.035)}.ds-button-primary:hover svg{transform:translateX(3px)}}@media(max-width:639px){.ds-button-primary{width:100%}}@media(prefers-reduced-motion:reduce){.ds-button-primary,.ds-button-primary svg{transition-duration:.01ms}}"
    },
    {
      "name": "Secondary telephone action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Gerahmter Telefonzugang im Einstieg, ohne zusätzliche Bildmetapher.",
      "html": "<a class=\"ds-button-secondary\" href=\"tel:+49841935570\">0841 93557-0</a>",
      "css": ".ds-button-secondary{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);display:inline-flex;min-height:3rem;align-items:center;justify-content:center;gap:.6rem;border:1px solid var(--token-btn-secondary-border,#6E8388);border-radius:var(--token-button-radius,.125rem);padding:.7rem 1.2rem;font-size:.9375rem;font-weight:650;line-height:1.25;text-decoration:none;background:var(--token-btn-secondary-bg,transparent);color:var(--token-btn-secondary-text,#103B4A);box-shadow:none;transition:transform 220ms ease,box-shadow 220ms ease,filter 220ms ease}.ds-button-secondary svg{color:inherit;transition:transform 220ms ease}.ds-button-secondary:focus-visible{outline:2px solid var(--token-accent,#195D67);outline-offset:2px;border-radius:4px}.ds-button-secondary:active{transform:translateY(0)}@media(hover:hover) and (pointer:fine){.ds-button-secondary:hover{transform:translateY(-2px);box-shadow:0 14px 32px var(--token-shadow,rgba(15,23,42,.08));filter:brightness(1.035)}.ds-button-secondary:hover svg{transform:translateX(3px)}}@media(max-width:639px){.ds-button-secondary{width:100%}}@media(prefers-reduced-motion:reduce){.ds-button-secondary,.ds-button-secondary svg{transition-duration:.01ms}}"
    },
    {
      "name": "Labelled contact input",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Sichtbares Feldlabel, weißer Hintergrund, eigener Feldrahmen und Tastaturfokus.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-contact-email\">E-Mail-Adresse <span aria-hidden=\"true\">*</span></label><input class=\"ds-field-input\" id=\"ds-contact-email\" name=\"email\" type=\"email\" autocomplete=\"email\" placeholder=\"name@beispiel.de\" required></div>",
      "css": ".ds-field{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);display:grid;gap:.45rem}.ds-field-label{color:var(--token-label,#33464C);font-size:.875rem;font-weight:650;line-height:1.4}.ds-field-label span{color:var(--token-danger,#b91c1c)}.ds-field-input{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);min-height:3rem;max-width:100%;border-radius:.75rem;border:1px solid var(--token-input-border,#7E9296);background:var(--token-input-bg,#FFFFFF);color:var(--token-input-text,#33464C);padding:.75rem 1rem;font-size:15px;line-height:1.5;transition:border-color 200ms,box-shadow 200ms,background-color 200ms}.ds-field-input::placeholder{color:var(--token-muted,#53636A)}.ds-field-input:focus-visible{outline:2px solid var(--token-accent,#195D67);outline-offset:2px;border-radius:4px}@media(prefers-reduced-motion:reduce){.ds-field-input{transition-duration:.01ms}}"
    },
    {
      "name": "Desktop navigation links",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Die kurzen CMS-Navigationsbezeichnungen auf hellem Papier; das Produkt ergänzt Logo, Terminaktion und mobilen Menüdialog.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Hauptnavigation\"><a href=\"/rechtsgebiete-anwalt-ingolstadt\">Rechtsgebiete</a><a href=\"/anwaelte-ingolstadt\">Anwälte</a><a href=\"/anwaltskanzlei-ingolstadt\">Kanzlei</a><a href=\"/service-anwaelte-ingolstadt\">Service</a></nav>",
      "css": ".ds-nav{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-end;gap:1rem;min-height:72px;padding:0 1.5rem;background:#FAF8F3}.ds-nav a{color:var(--nav-link-color,#103B4A);font-size:12px;font-weight:600;letter-spacing:.025em;text-transform:uppercase;text-decoration:none;white-space:nowrap;transition:color 300ms}.ds-nav a:hover{color:var(--nav-link-hover,#195D67)}.ds-nav a:focus-visible{outline:2px solid var(--token-accent,#195D67);outline-offset:2px;border-radius:4px}@media(min-width:1536px){.ds-nav{gap:1.5rem}.ds-nav a{font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition-duration:.01ms}}"
    },
    {
      "name": "Kontakt information panel",
      "kind": "card",
      "refersTo": "contact-panel",
      "description": "Eines von vier Kontaktpaneelen. Der lokale Sectionwert none gilt gleichermaßen für diese Paneele und das Formular; Weiß und 1px-Rahmen bleiben erhalten.",
      "html": "<div class=\"ds-contact-scope\"><article class=\"ds-contact-panel\"><span class=\"ds-contact-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.126.96.36 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.34 1.85.574 2.81.7A2 2 0 0 1 22 16.92z\"/></svg></span><div class=\"ds-contact-copy\"><div class=\"ds-contact-label\">Telefon</div><a class=\"ds-contact-value\" href=\"tel:+49841935570\">+49 841 93557-0</a></div></article></div>",
      "css": ".ds-contact-scope{--token-card-shadow:none;--token-card-bg:#FFFFFF;--token-card-border:#BBC6C5}.ds-contact-panel{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);display:flex;align-items:center;gap:1rem;padding:1.25rem;border:1px solid var(--token-card-border);border-radius:var(--token-card-radius,.125rem);background:var(--token-card-bg);box-shadow:var(--token-card-shadow);transition:border-color 280ms ease,box-shadow 280ms ease,transform 280ms ease}.ds-contact-icon{display:flex;flex-shrink:0;align-items:center;justify-content:center;width:3rem;height:3rem;border-radius:.75rem;background:color-mix(in srgb,var(--token-icon,#195D67) 12%,transparent);color:var(--token-icon,#195D67);transition:transform 150ms cubic-bezier(.4,0,.2,1)}.ds-contact-panel:hover .ds-contact-icon{transform:scale(1.1)}.ds-contact-copy{min-width:0;flex:1}.ds-contact-label{color:var(--token-muted,#53636A);font-size:.75rem;font-weight:500;line-height:1rem;text-transform:uppercase;letter-spacing:.05em}.ds-contact-value{display:block;padding:.25rem 0;color:var(--token-heading,#103B4A);font-size:1rem;font-weight:600;line-height:1.5;overflow-wrap:break-word;text-decoration:none;text-underline-offset:4px}.ds-contact-value:hover{text-decoration:underline}.ds-contact-value:focus-visible{outline:2px solid var(--token-icon,#195D67);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-contact-panel,.ds-contact-icon{transition-duration:.01ms}}"
    },
    {
      "name": "Open practice row",
      "kind": "custom",
      "refersTo": "practice-row",
      "description": "Der verlinkte Titel einer offenen Rechtsgebietszeile; konkrete Leistungsbeschreibungen stehen im Produkt darunter.",
      "html": "<article class=\"ds-practice\"><h3 class=\"ds-practice-title\"><a class=\"ds-practice-link\" href=\"/verkehrsrecht-rechtsanwalt-ingolstadt\"><span>Verkehrsrecht</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a></h3></article>",
      "css": ".ds-practice{border-top:1px solid var(--token-divider,#BBC6C5);padding:1.75rem 0}.ds-practice-title{font-family:var(--style-heading-font,\"Cormorant Garamond\",var(--font-outfit),system-ui,sans-serif);margin:0;color:var(--token-heading,#103B4A);font-size:1.5rem;font-weight:600;line-height:1.25;letter-spacing:-.02em}.ds-practice-link{display:flex;align-items:flex-start;justify-content:space-between;gap:1.25rem;padding:.25rem 0;color:inherit;text-decoration:none;text-underline-offset:4px}.ds-practice-link svg{flex-shrink:0;margin-top:.25rem;color:var(--token-icon,#195D67);transition:transform 150ms cubic-bezier(.4,0,.2,1)}.ds-practice-link:hover{text-decoration:underline}.ds-practice-link:hover svg{transform:translate(2px,-2px)}.ds-practice-link:focus-visible{outline:2px solid var(--token-icon,#195D67);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-practice-link svg{transition-duration:.01ms}}"
    },
    {
