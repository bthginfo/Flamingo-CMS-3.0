      "html": "<article class=\"ds-person\"><h3 class=\"ds-person-name\"><a href=\"/veronika-hagn-anwalt-ingolstadt\">Veronika Hagn</a></h3><p class=\"ds-person-role\">Rechtsanwältin · Fachanwältin für Verkehrsrecht und Strafrecht</p><p class=\"ds-person-focus\">Verkehrsrecht · Strafrecht · Allgemeines Zivilrecht</p></article>",
      "css": ".ds-person{font-family:var(--custom-body-font,\"Manrope\",var(--font-inter),system-ui,sans-serif);border-bottom:1px solid var(--token-divider,#BBC6C5);padding-bottom:1.5rem;color:var(--token-body,#33464C)}.ds-person-name{font-family:var(--style-heading-font,\"Cormorant Garamond\",var(--font-outfit),system-ui,sans-serif);margin:0;color:var(--token-heading,#103B4A);font-size:1.7rem;font-weight:500;line-height:1.25;letter-spacing:-.02em}.ds-person-name a{color:inherit;text-decoration:none;text-underline-offset:4px}.ds-person-name a:hover{text-decoration:underline}.ds-person-name a:focus-visible{outline:2px solid var(--token-icon,#195D67);outline-offset:4px}.ds-person-role{margin:.5rem 0 0;font-size:.875rem;line-height:1.5rem;color:var(--token-body,#33464C)}.ds-person-focus{margin:.75rem 0 0;font-size:.875rem;line-height:1.5rem;color:var(--token-muted,#53636A)}"
